# Copy to `.env` and fill in. `.env` is gitignored.
#
# WARNING: EXPO_PUBLIC_* values are inlined into the JS bundle at build time.
# This keeps the key out of version control, but it is still extractable from a
# shipped APK/IPA with `strings`. For a production release the key belongs on a
# server-side proxy that this app calls instead.
EXPO_PUBLIC_WEATHER_API_KEY=your_visual_crossing_key_here
