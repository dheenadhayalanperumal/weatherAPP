{
  "expo": {
    "name": "True Weather",
    "slug": "weatherapp",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "trueweather",
    "extra": {
      "eas": {
        "projectId": "1017dcd6-4092-404e-8229-98390b0ecbfa"
      }
    },
    "android": {
      "package": "com.dheena007.weatherapp",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.dheena007.weatherapp",
      "buildNumber": "6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "True Weather uses your location to show the forecast where you are. Your location is only used to look up the weather and is never stored or shared."
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#CAF4FF",
          "dark": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#0A1620"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "True Weather uses your location to show the forecast where you are. Your location is only used to look up the weather and is never stored or shared.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
